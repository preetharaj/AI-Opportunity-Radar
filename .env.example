# ============================================================
# AI Opportunity Radar — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real values.

# ── Umami Analytics ──────────────────────────────────────────
# Get these from your Umami dashboard after setup.
# Leave blank to run in dev/console-only mode.

# Your Umami website ID (from Settings → Websites in Umami dashboard)
PUBLIC_UMAMI_WEBSITE_ID==

# Script URL — use default for Umami Cloud, or your self-hosted URL
# Default: https://cloud.umami.is/script.js
PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js

# ── Site URL ─────────────────────────────────────────────────
# Your production URL — used by RSS feed and sitemap
SITE=https://YOUR_USERNAME.github.io

# ─── Auth ────────────────────────────────────────────────────────────────────
# Random 32+ char secret. Generate: openssl rand -base64 32
AUTH_SECRET=your_auth_secret_here

# ─── Database (Turso) ────────────────────────────────────────────────────────
# Create free DB at https://turso.tech
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Free tier: 3,000 emails/month. https://resend.com
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=noreply@yourdomain.com

# ─── App ─────────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Production: https://your-vercel-app.vercel.app

# ─── Cron security ───────────────────────────────────────────────────────────
# Random secret used by GitHub Actions to authenticate cron calls
CRON_SECRET=your_cron_secret_here

# ─── NEVER expose any of these in client components ──────────────────────────
# All vars above are server-only (no NEXT_PUBLIC_ prefix intentionally)
